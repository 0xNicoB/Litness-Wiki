---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CopyButton from "../components/CopyButton.astro";
import {
  articles,
  categories,
  articleUrl,
  categoryUrl,
  dateLabel,
} from "../lib/wiki";
import { site } from "../config/site";
const pages = await articles();
const featured = pages.filter((p) => p.data.featured).slice(0, 3);
const starters = [
  "it/iniziare/entrare",
  "it/iniziare/primi-passi",
  "it/territori/claim",
];
const news = pages.filter(
  (p) => p.data.category === "informazioni" && p.id.endsWith("aggiornamenti"),
);
const recent = [...pages]
  .sort(
    (a, b) =>
      b.data.updated.localeCompare(a.data.updated) ||
      a.data.order - b.data.order,
  )
  .slice(0, 4);
---

<Base
  ><main id="main">
    <section class="hero">
      <img
        class="hero-image"
        src="/images/hero.webp"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      /><div class="hero-overlay"></div><div class="hero-content">
        <span class="hero-kicker"
          ><span></span>IL TUO COMPAGNO DI AVVENTURA</span
        ><h1>Litness <span>Wiki.</span></h1><p class="hero-description">
          Ogni avventura inizia con una buona guida.<br />Scopri il mondo,
          comprendi le regole,<br class="desktop-break" /> costruisci la tua strada.
        </p><span class="hero-independent"
          >Una wiki indipendente, fatta dalla community.</span
        ><button class="hero-search" data-open-search
          ><Icon name="Search" size={24} /><span>Cosa vuoi scoprire?</span><kbd
            >Ctrl K</kbd
          ><span class="search-arrow"><Icon name="ArrowRight" /></span></button
        ><div class="hero-buttons">
          <a href="/wiki/" class="button primary"
            >Esplora la wiki <Icon name="ArrowRight" size={18} /></a
          ><CopyButton
            value={site.serverIp}
            label={site.serverIp}
            class="hero-copy"
          /><a class="hero-discord" href={site.discord}
            ><Icon name="MessageCircle" size={17} />Discord ufficiale<Icon
              name="ArrowUpRight"
              size={14}
            /></a>
        </div>
      </div><div class="hero-caption">
        <Icon name="Sparkles" size={14} />Paesaggio originale · illustrazione
        voxel
      </div>
    </section>
    <div class="trust-strip">
      <div>
        <Icon name="BookOpen" size={18} /><span>Guide in italiano</span>
      </div><div>
        <Icon name="ShieldCheck" size={18} /><span
          >Fonti e date trasparenti</span>
      </div><div>
        <Icon name="Github" size={18} /><a
          href="/wiki/it/informazioni/contribuire/">Aperta ai contributi</a>
      </div><div>
        <span class="small-dot"></span><span>Indipendente e non ufficiale</span>
      </div>
    </div>
    <section class="section categories-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">TUTTO QUELLO CHE TI SERVE</span><h2>
            Trova la tua strada.
          </h2>
        </div><a class="text-link" href="/wiki/"
          >Tutti gli articoli <Icon name="ArrowRight" size={17} /></a>
      </div><div class="category-grid">
        {
          categories.map((cat, i) => (
            <a class="category-card" href={categoryUrl(cat.id)}>
              <>
                <div class="category-card-top">
                  <>
                    <span class="category-icon">
                      <Icon name={cat.icon} size={25} />
                    </span>
                    <span class="category-number">0{i + 1}</span>
                  </>
                </div>
                <h3>{cat.title}</h3>
                <p>{cat.description}</p>
                <span class="category-arrow">
                  <Icon name="ArrowUpRight" size={21} />
                </span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="starter-section section">
      <div class="starter-intro">
        <span class="eyebrow">LA PRIMA VOLTA SU LITNESS?</span><h2>
          Inizia da qui.
        </h2><p>
          Dal primo accesso alla tua prima base. Tre guide per partire con le
          informazioni giuste.
        </p><a class="text-link" href="/wiki/it/iniziare/primi-passi/"
          >La guida ai primi passi <Icon name="ArrowRight" size={18} /></a>
      </div><div class="starter-list">
        {
          starters.map((id, i) => {
            const article = pages.find((p) => p.id === id)!;
            return (
              <a href={articleUrl(article.id)}>
                <>
                  <span class="step-number">0{i + 1}</span>
                  <div>
                    <>
                      <h3>{article.data.title}</h3>
                      <p>{article.data.description}</p>
                    </>
                  </div>
                  <Icon name="ArrowRight" size={21} />
                </>
              </a>
            );
          })
        }
      </div>
    </section>
    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DA TENERE A PORTATA DI MANO</span><h2>
            Guide in evidenza.
          </h2>
        </div><span class="section-note">Leggi, confronta, approfondisci.</span>
      </div><div class="featured-grid">
        {featured.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
    <section class="news-section section">
      <div>
        <span class="eyebrow">UNA WIKI CHE CRESCE CON TE</span><h2>
          Appunti dal mondo<br />di Litness.
        </h2><p>
          Gli aggiornamenti del server e le revisioni della wiki, con la data e
          la fonte sempre visibili.
        </p>{
          news.map((p) => (
            <a class="button secondary" href={articleUrl(p.id)}>
              Le patch documentate <Icon name="ArrowRight" size={18} />
            </a>
          ))
        }<a class="text-link official-news" href="https://litness.gg/blog"
          >Leggi le news ufficiali <Icon name="ArrowUpRight" size={16} /></a>
      </div><div class="recent-list">
        <span class="eyebrow">ULTIME REVISIONI DELLA WIKI</span>{
          recent.map((p) => (
            <a href={articleUrl(p.id)}>
              <>
                <time datetime={p.data.updated}>
                  {dateLabel(p.data.updated)}
                </time>
                <h3>{p.data.title}</h3>
                <Icon name="ArrowUpRight" size={19} />
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="contribute-banner section">
      <Icon name="Github" size={33} /><div>
        <h2>Una scoperta può aiutare tutti.</h2><p>
          Hai trovato un’informazione nuova o una correzione? Condividi una
          fonte.
        </p>
      </div><a class="button primary" href="/wiki/it/informazioni/contribuire/"
        >Contribuisci alla wiki <Icon name="ArrowRight" size={17} /></a>
    </section>
  </main></Base
>

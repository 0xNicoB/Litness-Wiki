---
import Icon from "./Icon.astro";
import { articleUrl, type Article, statusLabels } from "../lib/wiki";
interface Props {
  article: Article;
}
const { article } = Astro.props;
---

<a class="article-card" href={articleUrl(article.id)}
  ><span class="eyebrow">{statusLabels[article.data.status]}</span><h3>
    {article.data.title}
  </h3><p>{article.data.description}</p><span class="card-link"
    >Leggi la guida <Icon name="ArrowRight" size={18} /></span
  ></a
>

---
interface Props {
  caption: string;
  minWidth?: number;
}
const { caption, minWidth } = Astro.props;
---

<div class="data-table" role="region" aria-label={caption} tabindex="0" style={minWidth ? `--table-min-width: ${minWidth}px` : undefined}>
  <slot />
</div><p class="data-caption">{caption}</p>

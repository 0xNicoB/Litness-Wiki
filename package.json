{
  "name": "litness-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "astro build && pagefind --site dist && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/paytone-one": "5.3.0",
    "@lucide/astro": "1.53.0",
    "@pagefind/default-ui": "1.5.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "cheerio": "1.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
